<Window x:Class="PR1.Windows.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR1.Windows"
        mc:Ignorable="d"
        Title="Корзина - Цветочная мастерская"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ListBox x:Name="lstCart" Grid.Row="1"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="#E4DCD3" BorderThickness="1"
                            Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Image}" Width="64" Height="64"
                                   Stretch="UniformToFill" />

                            <StackPanel Grid.Column="1" Margin="14,0,14,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PriceText}"
                                           Foreground="#7A726B" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="-" Width="32" Padding="0"
                                        Click="btnMinus_Click" />
                                <TextBlock Text="{Binding Quantity}" Width="36"
                                           TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Content="+" Width="32" Padding="0"
                                        Margin="0,0,14,0" Click="btnPlus_Click" />
                                <TextBlock Text="{Binding SumText}" Width="90"
                                           TextAlignment="Right" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Content="Удалить" Margin="14,0,0,0"
                                        Click="btnDelete_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblEmpty" Text="Корзина пуста"
                       Foreground="#7A726B" VerticalAlignment="Center" />

            <TextBlock x:Name="lblTotal" Grid.Column="1" FontSize="18"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <Button Grid.Column="2" Content="Оформить заказ" Height="40"
                    Margin="0" x:Name="btnCheckout" Click="btnCheckout_Click" />
        </Grid>
    </Grid>
</Window>