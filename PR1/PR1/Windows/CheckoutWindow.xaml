<Window x:Class="PR1.Windows.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR1.Windows"
        mc:Ignorable="d"
        Title="Оформление заказа"
        Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid Margin="40,24,40,20">
        <StackPanel>
            <TextBlock Text="Оформление заказа" FontSize="24" FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <TextBlock Text="ФИО" Margin="0,0,0,4" />
            <TextBox x:Name="tbFullName" />

            <TextBlock Text="Телефон" Margin="0,0,0,4" />
            <TextBox x:Name="tbPhone" />
            <TextBlock Text="+7 XXX XXX-XX-XX" Foreground="#7A726B" FontSize="12"
                       Margin="0,-6,0,10" />

            <TextBlock Text="Адрес доставки" Margin="0,0,0,4" />
            <TextBox x:Name="tbAddress" />
            <TextBlock Text="ул. Ленина, д. 5, кв. 12" Foreground="#7A726B" FontSize="12"
                       Margin="0,-6,0,10" />

            <CheckBox x:Name="cbNoApartment" Content="Нет квартиры (частный дом)"
                      Margin="0,0,0,12" />

            <TextBlock x:Name="lblError" Foreground="#B3261E"
                       Visibility="Collapsed" Margin="0,0,0,10" />

            <Border Background="White" BorderBrush="#E4DCD3" BorderThickness="1"
                    Padding="12" Margin="0,0,0,16">
                <TextBlock x:Name="lblTotal" FontSize="18" FontWeight="SemiBold" />
            </Border>

            <Button Content="Отправить заказ" Height="40" IsDefault="True"
                    Margin="0,0,0,8" x:Name="btnSubmit" Click="btnSubmit_Click" />
            <Button Content="Отмена" IsCancel="True" x:Name="btnCancel" Click="btnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>